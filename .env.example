# Copia este archivo como .env (no se versiona). Las contraseñas solo van por variables de entorno;
# en CI se cargan como secrets de GitHub.
# Pon las contraseñas ENTRE COMILLAS SIMPLES (PASSWORD='…'): dotenv corta un valor sin comillas en
# el primer «#», y una contraseña incompleta suma fallos de login reales hasta bloquear la cuenta.

# App bajo prueba (frontend con proxy /api y /ws hacia el backend)
BASE_URL=http://localhost:5173

# Administrador demo (DataSeeder): crea los datos de prueba y revisa /auditoria
ADMIN_CORREO=admin@tdea.edu.co
ADMIN_PASSWORD=

# Instructor demo: solo para CP-HU002-01 (login de instructor con OTP)
INSTRUCTOR_DEMO_CORREO=laura.mejia@tdea.edu.co
INSTRUCTOR_DEMO_PASSWORD=

# Correo que ya existe y nunca inicia sesión (CP-HU001-02, TC-INS-01)
CORREO_EXISTENTE=andres.gomez@tdea.edu.co

# Contraseña definitiva de las cuentas que crea la prueba en su primer acceso.
# Debe cumplir la política: 10 a 72 caracteres, mayúscula, minúscula, número y símbolo,
# y no contener «e2e» ni la parte local del correo.
E2E_PASSWORD=

# Configuración que puede cambiar en la app (no se escribe en duro en las pruebas)
APP_DOMINIO=tdea.edu.co
OTP_MINUTOS=10
# Etiqueta del campo de correo en login, recuperación, desbloqueo y «Nuevo usuario» (support/config.js).
# Cuando la app acepte también @gmail.com, @outlook.com y los dominios del admin, se cambia aquí.
ETIQUETA_CORREO=Correo institucional

# Ejecución
CICLO=1
SLOW_MO=400
# Retraso entre teclas, en ms (tecleo humano)
TECLEO_MS=40
# Ruta local del repo de la app, para leer su commit (o define APP_COMMIT)
APP_REPO_DIR=../v-learning-platform
APP_COMMIT=
EJECUTADO_POR=
# 1 si Ollama está disponible con el modelo cargado (casos del Tutor con respuesta real)
OLLAMA_DISPONIBLE=0

# Verificación de la base aislada al empezar cada corrida (support/verificar-base.js).
# 1 = comprueba con una sonda de login que el backend escribe en E2E_BASE_DATOS; 0 = la omite (p. ej. en CI sin psql).
E2E_VERIFICAR_BASE=1
E2E_BASE_DATOS=vlearning_e2e
PSQL=C:\Program Files\PostgreSQL\18\bin\psql.exe
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
# Si se deja vacío se toma del .env del backend (APP_REPO_DIR/backend/learning-platform/.env). Entre comillas simples.
DB_PASSWORD=
